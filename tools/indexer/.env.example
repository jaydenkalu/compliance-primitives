# REQUIRED: Soroban RPC endpoint
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-rpc.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Set at least one contract ID; leave unused contract slots empty.
ALLOWLIST_CONTRACT_ID=
DENYLIST_CONTRACT_ID=
JURISDICTION_CONTRACT_ID=
MULTISIG_CONTRACT_ID=
AGGREGATOR_CONTRACT_ID=
POLICY_ENGINE_CONTRACT_ID=
CIRCUIT_BREAKER_CONTRACT_ID=
AUDIT_LOG_CONTRACT_ID=

# REQUIRED: SQLite database file path (relative to cwd or absolute)
DB_PATH=compliance.db

# How often to poll for new events (milliseconds)
POLL_INTERVAL_MS=5000

# Ledger sequence to start from.
# 0 = auto-detect (will start from ~24h ago on the connected node).
# Set to a specific ledger if you know when your contracts were deployed.
START_LEDGER=0

# Optional inclusive upper bound for a one-time historical backfill.
# The indexer exits after it has indexed through this ledger. 0 = keep polling.
END_LEDGER=0
